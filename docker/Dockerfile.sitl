# Betaflight SITL, pinned to the exact firmware commit on the real FC.
#
# Why Docker and not a native macOS build: Betaflight 4.5.1's SITL target links
# with a GNU linker script (src/main/target/SITL/pg.ld) that builds the
# .pg_registry parameter-group section and the __pg_registry_start/end symbols
# Betaflight's config system depends on. Apple's ld64 has no linker-script
# support at all, and the link line also uses GNU-only -gc-sections, --cref and
# -lrt. Every one of the 257 objects compiles cleanly under Apple clang; it is
# only the link that cannot work. See docs/sitl_interface.md section 6.
#
# Build context is irrelevant -- the source is fetched by commit, so the image
# cannot silently drift from third_party/betaflight.

# ---- build ----------------------------------------------------------------
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Must match third_party/betaflight and config/quad.yaml:firmware. This is the
# commit string printed in the FC's own `diff all` header.
ARG BF_COMMIT=77d01ba3b76a22909d5f09cb0628820141f95eaa

WORKDIR /src
RUN git init -q betaflight \
 && cd betaflight \
 && git remote add origin https://github.com/betaflight/betaflight.git \
 && git fetch -q --depth 1 origin "${BF_COMMIT}" \
 && git checkout -q FETCH_HEAD \
 && test "$(git rev-parse HEAD)" = "${BF_COMMIT}"

WORKDIR /src/betaflight
# ARM_SDK_DIR=/usr: mk/tools.mk is included at Makefile:104, before the SITL
# target blanks ARM_SDK_PREFIX at mk/mcu/SITL.mk:15, so it demands
# arm-none-eabi-gcc even for a host build. Pointing it at any existing
# directory takes the branch that skips the check. Not a source patch.
# ---------------------------------------------------------------------------
# THE ONE PATCH TO UPSTREAM, and why it is not optional here.
#
# src/main/main.c sleeps between scheduler passes:
#
#     while (true) {
#         scheduler();
#     #ifdef SIMULATOR_BUILD
#         delayMicroseconds_real(50); // max rate 20kHz
#     #endif
#     }
#
# 50 us assumes a host where nanosleep is accurate to microseconds. Inside
# Docker Desktop's VM on macOS it costs milliseconds, pinning the loop near
# 300 Hz. Betaflight's realtime tasks -- TASK_GYRO, TASK_FILTER and TASK_PID --
# run ONLY inside `if (gyroEnabled)` (scheduler.c:488-533) and only when the
# scheduler is entered within SCHED_START_LOOP_MIN_US = 1 us of the gyro
# deadline (scheduler.h:37, scheduler.c:515). At ~3 ms per pass it never lands
# in that window, so those three tasks NEVER EXECUTE: the gyro reads a flat
# zero and no motor packets are ever sent, while ordinary-priority tasks like
# TASK_ACCEL keep running and make it look as though SITL is healthy.
#
# Measured with this patch: gyro live and correct, PID cycleTime 76-147 us.
# Without it: gyro 0, cycleTime 0, `tasks` shows GYRO/FILTER/PID at 0 Hz.
#
# The `grep -q` makes the build FAIL if upstream changes that line, so the
# patch can never silently stop applying. Full write-up:
# docs/sitl_interface.md section 6.
ARG SITL_LOOP_SLEEP_US=1
RUN grep -q 'delayMicroseconds_real(50);' src/main/main.c \
 || (echo "main.c no longer has the 50us scheduler sleep -- re-check the patch" >&2; exit 1)
RUN sed -i "s@delayMicroseconds_real(50);@delayMicroseconds_real(${SITL_LOOP_SLEEP_US});@" src/main/main.c \
 && grep -n 'delayMicroseconds_real' src/main/main.c

RUN make TARGET=SITL ARM_SDK_DIR=/usr -j"$(nproc)" \
 && test -f obj/main/betaflight_SITL.elf

# ---- runtime --------------------------------------------------------------
FROM debian:bookworm-slim

COPY --from=build /src/betaflight/obj/main/betaflight_SITL.elf /usr/local/bin/betaflight_SITL
COPY sitl-entrypoint.sh /usr/local/bin/sitl-entrypoint.sh
RUN chmod +x /usr/local/bin/sitl-entrypoint.sh

# eeprom.bin (the saved config) is written to the working directory. Mount a
# host directory here or the config is lost when the container is removed.
WORKDIR /data
VOLUME ["/data"]

# Only the ports SITL actually LISTENS on. 9001/9002 are its outbound direction
# (sitl.c:80-81 "// Out", udpInit(..., isServer=false) at :310,:313) -- nothing
# in here binds them, and publishing them would take the host port away from the
# physics process that has to receive on it.
# 5761 = UART1 for the Configurator (serial_tcp.c:41,113 -> BASE_PORT+id+1).
EXPOSE 5761/tcp
EXPOSE 9003/udp 9004/udp

ENTRYPOINT ["/usr/local/bin/sitl-entrypoint.sh"]
