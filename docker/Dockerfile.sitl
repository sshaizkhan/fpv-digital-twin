# Betaflight SITL, pinned to the exact firmware commit on the real FC.
#
# Why Docker and not a native macOS build: Betaflight 4.5.1's SITL target links
# with a GNU linker script (src/main/target/SITL/pg.ld) that builds the
# .pg_registry parameter-group section and the __pg_registry_start/end symbols
# Betaflight's config system depends on. Apple's ld64 has no linker-script
# support at all, and the link line also uses GNU-only -gc-sections, --cref and
# -lrt. Every one of the 257 objects compiles cleanly under Apple clang; it is
# only the link that cannot work. See docs/sitl_interface.md section 6.
#
# Build context is irrelevant -- the source is fetched by commit, so the image
# cannot silently drift from third_party/betaflight.

# ---- build ----------------------------------------------------------------
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Must match third_party/betaflight and config/quad.yaml:firmware. This is the
# commit string printed in the FC's own `diff all` header.
ARG BF_COMMIT=77d01ba3b76a22909d5f09cb0628820141f95eaa

WORKDIR /src
RUN git init -q betaflight \
 && cd betaflight \
 && git remote add origin https://github.com/betaflight/betaflight.git \
 && git fetch -q --depth 1 origin "${BF_COMMIT}" \
 && git checkout -q FETCH_HEAD \
 && test "$(git rev-parse HEAD)" = "${BF_COMMIT}"

WORKDIR /src/betaflight
# ARM_SDK_DIR=/usr: mk/tools.mk is included at Makefile:104, before the SITL
# target blanks ARM_SDK_PREFIX at mk/mcu/SITL.mk:15, so it demands
# arm-none-eabi-gcc even for a host build. Pointing it at any existing
# directory takes the branch that skips the check. Not a source patch.
RUN make TARGET=SITL ARM_SDK_DIR=/usr -j"$(nproc)" \
 && test -f obj/main/betaflight_SITL.elf

# ---- runtime --------------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      iproute2 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/betaflight/obj/main/betaflight_SITL.elf /usr/local/bin/betaflight_SITL
COPY sitl-entrypoint.sh /usr/local/bin/sitl-entrypoint.sh
RUN chmod +x /usr/local/bin/sitl-entrypoint.sh

# eeprom.bin (the saved config) is written to the working directory. Mount a
# host directory here or the config is lost when the container is removed.
WORKDIR /data
VOLUME ["/data"]

# 9001 pwm_raw out, 9002 pwm out, 9003 state in, 9004 rc in (sitl.c:80-83);
# 5761 = UART1 for the Configurator (serial_tcp.c:41,113 -> BASE_PORT+id+1).
EXPOSE 5761/tcp
EXPOSE 9001/udp 9002/udp 9003/udp 9004/udp

ENTRYPOINT ["/usr/local/bin/sitl-entrypoint.sh"]
